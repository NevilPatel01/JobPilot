# Copy this file to `.env.local` and fill in the values.

# The URL the browser hits. Must exactly match your GitHub OAuth callback host.
NEXTAUTH_URL=http://localhost:3000

# REQUIRED for OAuth. Must be set and identical between restarts, otherwise the
# session cookie can't be decoded and you get a /login <-> /dashboard loop.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret-here

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set BOTH to false to actually use GitHub/Google sign-in.
# Leave them true to skip auth entirely for quick local dev.
AUTH_DISABLED=true
NEXT_PUBLIC_AUTH_DISABLED=true

# Auto-set at build when GITHUB_ID is present; override manually if needed:
NEXT_PUBLIC_HAS_GITHUB=
NEXT_PUBLIC_HAS_GOOGLE=
NEXT_PUBLIC_HIRE_ME_URL=https://github.com/NevilPatel01
